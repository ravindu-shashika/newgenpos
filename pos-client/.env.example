# Set to true when Laravel Reverb is running (php artisan reverb:start)
VITE_REVERB_ENABLED=false
VITE_REVERB_APP_KEY=local-pos-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Laravel app URL on cPanel: https://pos.newgenideas.com/api (api.js appends /api for routes → …/api/api/login)
VITE_APP_DEFAULT_PATH=http://127.0.0.1:8000
REACT_APP_DEFAULT_PATH=http://127.0.0.1:8000
# Production / GitHub secret VITE_APP_DEFAULT_PATH: https://pos.newgenideas.com/api
# Set to false only during development to show all menus/buttons without permission checks
# VITE_ENFORCE_PERMISSIONS=false
