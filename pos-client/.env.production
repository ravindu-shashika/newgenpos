# Production build — domain and API URL are AUTO from window.location
# (pos.newgenideas.com → API https://pos.newgenideas.com/api/api/…)
# No need to set VITE_APP_DOMAIN or REACT_APP_DOMAIN here.

# Optional override only if API is on a different host than the SPA:
# VITE_APP_DEFAULT_PATH=https://other-host.com/api
# REACT_APP_DEFAULT_PATH=https://other-host.com/api
